# Settings for running your tests. Copy to .env (`cp .env.example .env`); .env stays out of git.
# A variable set in your shell wins over the same key here. Every setting, where it can be set and its default,
# is in the framework checkout's docs/SETTINGS.md.

# Every run must say whether it owns the Striim cluster and the containers it uses. `shared` reuses
# what is running and never tears anything down; it needs SLT_KEEP_SERVICES=1.
SLT_INFRA_OWNERSHIP=shared
SLT_KEEP_SERVICES=1

# Your own Striim server. Leave STRIIM_URL unset for Docker mode, which needs a license exported in
# your shell (STRIIM_HOME, or COMPANY_NAME, CLUSTER_NAME, PRODUCT_KEY and LICENCE_KEY).
# STRIIM_URL=http://striim.example.com:9080
# STRIIM_USER=admin
# STRIIM_PASS=
# Default timeout on Striim REST calls, seconds: "600" (read), "10,600" (connect,read), or "0" for none.
# The login and read-only polls (status, MON, DESCRIBE, SHOW ... CHECKPOINT HISTORY, LIST LIBRARIES,
# LIST DEPLOYMENTGROUPS) use (10,120), re-login the rest of its deadline; "0" also turns these off.
# Jar LOAD/UNLOAD use none.
# STRIIM_API_TIMEOUT=10,600

# Your own database instead of the framework's container, for example Postgres:
# SLT_PG_HOST=db.example.com
