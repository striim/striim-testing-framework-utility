<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.example</groupId>
	<artifactId>ReferenceUdf</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>ReferenceUdf</name>
	<description>Striim UDF library demonstrating the minimal WAEvent-aware UDF shape. Canonical gold-standard-shape reference (see docs/TESTING-YOUR-JAVA.md) — the UDF analog of OpenProcessors/ReferenceOp, not a product feature.</description>

	<properties>
		<!-- Reproducible build. Without this, maven-jar-plugin and maven-shade-plugin stamp
		     every zip entry with the moment of the build, so `mvn clean package` over an
		     UNCHANGED tree emits a different sha256 every time. The live framework treats a
		     changed jar as one it must re-register, which is an UNLOAD + LOAD OPEN PROCESSOR of
		     cluster-wide state and the operation that wedges Striim's OP loader: a
		     non-reproducible module makes every repeat run reload it for nothing. Bump the date
		     when you want the stamp to move, never per build. -->
		<project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
		<UDF_VERSION>V1</UDF_VERSION>

		<!-- Striim-AWARE: ReferenceUdf compiles against WAEvent (com.webaction.proc.events), so
		     STRIIM_HOME/STRIIM_VERSION/JAVA_RELEASE resolve real system-scoped jars below. -->
		<STRIIM_HOME>/opt/striim</STRIIM_HOME>
		<STRIIM_VERSION>5.4.0.6</STRIIM_VERSION>
		<STRIIM_SERIES>5.4</STRIIM_SERIES>
		<JAVA_RELEASE>17</JAVA_RELEASE>

		<!-- Transitive Striim runtime lib: WAEvent implements KryoSerializable, so this is
		     required to compile against it, not just an optional extra. Frozen across releases
		     (same jar in every Striim install's lib/), so no release-from-env override. -->
		<KRYO_VERSION>2.20</KRYO_VERSION>

		<maven.compiler.source>${JAVA_RELEASE}</maven.compiler.source>
		<maven.compiler.target>${JAVA_RELEASE}</maven.compiler.target>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.webaction</groupId>
			<artifactId>Platform</artifactId>
			<version>${STRIIM_VERSION}</version>
			<scope>system</scope>
			<systemPath>${STRIIM_HOME}/lib/Platform-${STRIIM_VERSION}.jar</systemPath>
		</dependency>
		<dependency>
			<groupId>com.webaction</groupId>
			<artifactId>Common</artifactId>
			<version>${STRIIM_VERSION}</version>
			<scope>system</scope>
			<systemPath>${STRIIM_HOME}/lib/Common-${STRIIM_VERSION}.jar</systemPath>
		</dependency>
		<dependency>
			<groupId>com.esotericsoftware</groupId>
			<artifactId>kryo</artifactId>
			<version>${KRYO_VERSION}</version>
			<scope>system</scope>
			<systemPath>${STRIIM_HOME}/lib/kryo-${KRYO_VERSION}.jar</systemPath>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.10.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>${project.artifactId}${UDF_VERSION}-${STRIIM_SERIES}</finalName>
		<plugins>
			<!-- Compiles SampleCommon's shared sources directly into this module's build
			     (rather than depending on it as a jar) so they land in this UDF's single
			     output jar. Same mechanism the OPs use for OpenProcessorCommon. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<id>add-common-source</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.basedir}/../../SampleCommon/src/main/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
				</configuration>
			</plugin>
			<!--
			  surefire PINNED to 3.2.5: an unpinned surefire silently falls back to 2.12.4, which
			  predates JUnit 5 and reports a vacuous "Tests run: 0" green. Do not remove the pin.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<useManifestOnlyJar>false</useManifestOnlyJar>
					<additionalClasspathElements>
						<additionalClasspathElement>${STRIIM_HOME}/lib/*</additionalClasspathElement>
					</additionalClasspathElements>
				</configuration>
			</plugin>
			<!-- Shade solely to relocate the shared package to a module-unique name:
			     Striim's global LOAD rejects two jars declaring the same class.
			     outputFile writes over the default jar, so target/ holds exactly one. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.1</version>
				<configuration>
					<createDependencyReducedPom>false</createDependencyReducedPom>
					<outputFile>${project.build.directory}/${project.artifactId}${UDF_VERSION}-${STRIIM_SERIES}.jar</outputFile>
					<relocations>
						<relocation>
							<pattern>com.example.common</pattern>
							<shadedPattern>com.example.shaded.${project.artifactId}.common</shadedPattern>
						</relocation>
					</relocations>
					<transformers>
						<transformer
							implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
							<manifestEntries>
								<!-- Re-stamped here because shade rewrites the jar the
								     maven-jar-plugin archive block produced. -->
								<Striim-Build-Version>${STRIIM_VERSION}</Striim-Build-Version>
								<Striim-Build-Series>${STRIIM_SERIES}</Striim-Build-Series>
								<Striim-Build-Java>${JAVA_RELEASE}</Striim-Build-Java>
							</manifestEntries>
						</transformer>
					</transformers>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.1</version>
				<configuration>
					<archive>
						<manifestEntries>
							<Striim-Build-Version>${STRIIM_VERSION}</Striim-Build-Version>
							<Striim-Build-Series>${STRIIM_SERIES}</Striim-Build-Series>
							<Striim-Build-Java>${JAVA_RELEASE}</Striim-Build-Java>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>

			<!-- ================================================================================
			     API docs and sources, bound to `package`. Output is named from this module's jar
			     base name, landing beside it as <jar>-sources.jar and <jar>-javadoc.jar.

			     Why bind rather than pass the goals on the command line: javadoc is only checked
			     when it is generated, and `mvn package` is the command a developer runs. A broken
			     reference fails that build; so does a @param naming an argument the method does
			     not have. A MISSING @param or @return is only a warning, which is deliberate,
			     because the templates require neither. The check is of form, never of truth: a
			     green build proves the tags RESOLVE, not that they are correct.

			     Do NOT also pass these goals on the command line where this pom is built. The
			     lifecycle already runs them, and a second `default-cli` execution regenerates and
			     re-jars the javadoc for nothing.

			     Both versions are PINNED for determinism, and as a floor against a future Maven 4
			     runner. The pin does not change which version resolves today: 4.0.0-beta-1 declares
			     a Maven 4 prerequisite, so Maven 3.9 rejects it and selects 3.4.0 unaided. Unlike
			     the surefire pin, which prevents a real and current silent-zero-tests green, this
			     one is insurance.

			     These two jars are DEVELOPER artifacts and are never shipped:
			     a packaging step should drop any -sources/-javadoc jar from a customer package.
			     target/ therefore holds more than one jar,
			     so anything counting jars there must exclude them.
			     The live harness is unaffected: it globs target/*-<series>.jar, which neither suffix
			     can match.
			     ================================================================================ -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.12.0</version>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

	<profiles>
		<profile>
			<id>striim-home-from-env</id>
			<activation><property><name>env.STRIIM_HOME</name></property></activation>
			<properties><STRIIM_HOME>${env.STRIIM_HOME}</STRIIM_HOME></properties>
		</profile>
		<profile>
			<id>release-from-env</id>
			<activation><property><name>env.STRIIM_RELEASE</name></property></activation>
			<properties>
				<STRIIM_VERSION>${env.STRIIM_VERSION}</STRIIM_VERSION>
				<STRIIM_SERIES>${env.STRIIM_SERIES}</STRIIM_SERIES>
				<JAVA_RELEASE>${env.JAVA_RELEASE}</JAVA_RELEASE>
			</properties>
		</profile>
	</profiles>
</project>
