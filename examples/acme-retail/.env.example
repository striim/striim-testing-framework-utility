# Copy to .env and configure Striim and disposable services per docs/SERVICES.md.
# Every setting, where it can be set and its default: the framework's docs/SETTINGS.md.
# Shell settings take precedence. Keep credentials out of version control.
SLT_INFRA_OWNERSHIP=shared
SLT_KEEP_SERVICES=1
# Leave STRIIM_URL unset for Docker mode; export its license in your shell: STRIIM_HOME (a licensed
# Striim install), or COMPANY_NAME, CLUSTER_NAME, PRODUCT_KEY and LICENCE_KEY.
# For an existing Striim server, set STRIIM_URL, STRIIM_USER and STRIIM_PASS in .env.
# For existing services, set SLT_PG_HOST, SLT_MYSQL_HOST and SLT_KAFKA_HOST in .env.
# If reusing a Striim container outside this stack prefix, configure the service host
# as seen from that container. On a local Docker host:
# SLT_STRIIM_VIEW_HOST=host.docker.internal
