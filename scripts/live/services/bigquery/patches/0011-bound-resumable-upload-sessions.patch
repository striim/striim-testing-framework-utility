+package server
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/goccy/bigquery-emulator/types"
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+)
+
+type uploadFixture struct {
+	s      *Server
+	client *http.Client
+	base   string
+	t      *testing.T
+}
+
+func newUploadFixture(t *testing.T) *uploadFixture {
+	t.Helper()
+	s, err := New(TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = s.Load(StructSource(types.NewProject("test", types.NewDataset("slt", types.NewTable("target", []*types.Column{types.NewColumn("id", types.INT64), types.NewColumn("msg", types.STRING)}, nil))))); err != nil {
+		t.Fatal(err)
+	}
+	ts := s.TestServer()
+	t.Cleanup(func() { ts.Close(); s.Stop(context.Background()) })
+	return &uploadFixture{s: s, client: &http.Client{Timeout: 10 * time.Second}, base: ts.URL, t: t}
+}
+func (f *uploadFixture) call(method, path string, body []byte, headers map[string]string, want int) (map[string]interface{}, http.Header) {
+	f.t.Helper()
+	if !strings.HasPrefix(path, "http") {
+		path = f.base + path
+	}
+	req, err := http.NewRequest(method, path, bytes.NewReader(body))
+	if err != nil {
+		f.t.Fatal(err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	for k, v := range headers {
+		req.Header.Set(k, v)
+	}
+	r, err := f.client.Do(req)
+	if err != nil {
+		f.t.Fatal(err)
+	}
+	defer r.Body.Close()
+	raw, err := io.ReadAll(r.Body)
+	if err != nil {
+		f.t.Fatal(err)
+	}
+	if r.StatusCode != want {
+		f.t.Fatalf("%s %s got%d want%d: %s", method, path, r.StatusCode, want, raw)
+	}
+	var doc map[string]interface{}
+	if len(raw) > 0 {
+		if err = json.Unmarshal(raw, &doc); err != nil {
+			f.t.Fatal(err)
+		}
+	}
+	return doc, r.Header
+}
+func (f *uploadFixture) begin(id, delimiter, disposition string) string {
+	f.t.Helper()
+	config := &bigqueryv2.Job{JobReference: &bigqueryv2.JobReference{ProjectId: "test", JobId: id}, Configuration: &bigqueryv2.JobConfiguration{Load: &bigqueryv2.JobConfigurationLoad{
+		DestinationTable: &bigqueryv2.TableReference{ProjectId: "test", DatasetId: "slt", TableId: "target"},
+		Schema:           &bigqueryv2.TableSchema{Fields: []*bigqueryv2.TableFieldSchema{{Name: "id", Type: "INTEGER"}, {Name: "msg", Type: "STRING"}}},
+		SourceFormat:     "CSV", FieldDelimiter: delimiter, NullMarker: "NULL", AllowQuotedNewlines: true, WriteDisposition: disposition,
+	}}}
+	raw, err := json.Marshal(config)
+	if err != nil {
+		f.t.Fatal(err)
+	}
+	_, headers := f.call("POST", "/upload/bigquery/v2/projects/test/jobs?uploadType=resumable", raw, nil, 200)
+	location := headers.Get("Location")
+	if !strings.HasPrefix(location, f.base+"/") {
+		f.t.Fatalf("unreachable origin %s want %s", location, f.base)
+	}
+	return location
+}
+func (f *uploadFixture) rows() map[string]string {
+	f.t.Helper()
+	doc, _ := f.call("GET", "/bigquery/v2/projects/test/datasets/slt/tables/target/data", nil, nil, 200)
+	result := map[string]string{}
+	rows, _ := doc["rows"].([]interface{})
+	for _, row := range rows {
+		cells := row.(map[string]interface{})["f"].([]interface{})
+		id := cells[0].(map[string]interface{})["v"].(string)
+		msg := cells[1].(map[string]interface{})["v"].(string)
+		if _, exists := result[id]; exists {
+			f.t.Fatalf("duplicate row for id=%s", id)
+		}
+		result[id] = msg
+	}
+	return result
+}
+func (f *uploadFixture) job(id string) map[string]interface{} {
+	f.t.Helper()
+	d, _ := f.call("GET", "/bigquery/v2/projects/test/jobs/"+id, nil, nil, 200)
+	return d
+}
+func loadStats(t *testing.T, doc map[string]interface{}) map[string]interface{} {
+	t.Helper()
+	return doc["statistics"].(map[string]interface{})["load"].(map[string]interface{})
+}
+
+func TestUploadHeaderlessLiteralHTTP(t *testing.T) {
+	for _, tc := range []struct {
+		name, payload, delimiter string
+		want                     map[string]string
+	}{
+		{"zero", "", "|", map[string]string{}},
+		{"one", "1|first\n", "|", map[string]string{"1": "first"}},
+		{"two", "1|first\n2|second\n", "|", map[string]string{"1": "first", "2": "second"}},
+		{"comma", "1,first\n2,second\n", ",", map[string]string{"1": "first", "2": "second"}},
+		{"tab", "1\tfirst\n2\tsecond\n", "\t", map[string]string{"1": "first", "2": "second"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newUploadFixture(t)
+			location := f.begin("literal", tc.delimiter, "WRITE_APPEND")
+			uploaded, _ := f.call("PUT", location, []byte(tc.payload), nil, 200)
+			if got := f.rows(); !reflect.DeepEqual(got, tc.want) {
+				t.Fatalf("got=%v want=%v", got, tc.want)
+			}
+			stats := loadStats(t, uploaded)
+			if stats["outputRows"] != fmt.Sprint(len(tc.want)) || stats["inputFileBytes"] != fmt.Sprint(len(tc.payload)) || stats["badRecords"] != "0" {
+				t.Fatalf("dishonest statistics %v", stats)
+			}
+			got := f.job("literal")
+			if !reflect.DeepEqual(got["statistics"], uploaded["statistics"]) || !reflect.DeepEqual(got["status"], uploaded["status"]) {
+				t.Fatalf("jobs.get differs: %v vs %v", got, uploaded)
+			}
+			reloaded, err := f.s.metaRepo.FindJob(context.Background(), "test", "literal")
+			if err != nil || reloaded == nil {
+				t.Fatalf("reload: %v %v", reloaded, err)
+			}
+			wire, err := json.Marshal(reloaded.Content())
+			if err != nil {
+				t.Fatal(err)
+			}
+			var persisted map[string]interface{}
+			if err = json.Unmarshal(wire, &persisted); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(loadStats(t, persisted), stats) {
+				t.Fatalf("persisted load statistics changed: %v vs %v", loadStats(t, persisted), stats)
+			}
+		})
+	}
+}
+
+func TestUploadChunkStatusReplayAndFinalization(t *testing.T) {
+	f := newUploadFixture(t)
+	location := f.begin("chunked", "|", "WRITE_APPEND")
+	payload := []byte("1|first\n2|second\n")
+	split := 9
+	partial := map[string]string{"Content-Range": fmt.Sprintf("bytes 0-%d/*", split-1)}
+	_, h := f.call("PUT", location, payload[:split], partial, 308)
+	if h.Get("Range") != "bytes=0-8" || len(f.rows()) != 0 {
+		t.Fatal("early rows or incorrect range")
+	}
+	if f.job("chunked")["status"].(map[string]interface{})["state"] != "PENDING" {
+		t.Fatal("incomplete upload is terminal")
+	}
+	f.call("PUT", location, nil, map[string]string{"Content-Range": "bytes */*"}, 308)
+	f.call("PUT", location, payload[:split], partial, 308)
+	f.call("PUT", location, payload[split+1:], map[string]string{"Content-Range": fmt.Sprintf("bytes %d-%d/%d", split+1, len(payload)-1, len(payload))}, 400)
+	if len(f.rows()) != 0 {
+		t.Fatal("out-of-order upload inserted rows")
+	}
+	final := map[string]string{"Content-Range": fmt.Sprintf("bytes %d-%d/%d", split, len(payload)-1, len(payload))}
+	uploaded, _ := f.call("PUT", location, payload[split:], final, 200)
+	if got := f.rows(); !reflect.DeepEqual(got, map[string]string{"1": "first", "2": "second"}) {
+		t.Fatal(got)
+	}
+	replayed, _ := f.call("PUT", location, payload[split:], final, 200)
+	if !reflect.DeepEqual(uploaded, replayed) {
+		t.Fatal("final replay changed terminal job")
+	}
+	f.call("PUT", location, []byte("different"), final, 400)
+	f.call("PUT", location, nil, map[string]string{"Content-Range": fmt.Sprintf("bytes */%d", len(payload))}, 200)
+	if got := f.rows(); !reflect.DeepEqual(got, map[string]string{"1": "first", "2": "second"}) {
+		t.Fatal(got)
+	}
+	if !reflect.DeepEqual(f.job("chunked")["statistics"], uploaded["statistics"]) {
+		t.Fatal("jobs.get changed load accounting")
+	}
+}
+
+func TestUploadInvalidRowsAreAtomic(t *testing.T) {
+	for _, tc := range []struct{ name, payload string }{
+		{"numeric", "1|first\nnot_an_integer|broken\n"},
+		{"jagged", "1|first\n2\n"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newUploadFixture(t)
+			f.call("POST", "/bigquery/v2/projects/test/datasets/slt/tables/target/insertAll", []byte(`{"rows":[{"json":{"id":99,"msg":"keep"}}]}`), nil, 200)
+			location := f.begin("bad", "|", "WRITE_TRUNCATE")
+			uploaded, _ := f.call("PUT", location, []byte(tc.payload), nil, 200)
+			status := uploaded["status"].(map[string]interface{})
+			if status["state"] != "DONE" || status["errorResult"] == nil {
+				t.Fatalf("failed load reported success: %v", uploaded)
+			}
+			stats := loadStats(t, uploaded)
+			if stats["outputRows"] != "0" || stats["outputBytes"] != "0" || stats["badRecords"] != "1" {
+				t.Fatal(stats)
+			}
+			if got := f.rows(); !reflect.DeepEqual(got, map[string]string{"99": "keep"}) {
+				t.Fatalf("partial/truncated target: %v", got)
+			}
+			if !reflect.DeepEqual(f.job("bad")["status"], uploaded["status"]) {
+				t.Fatal("jobs.get hid load error")
+			}
+		})
+	}
+}
