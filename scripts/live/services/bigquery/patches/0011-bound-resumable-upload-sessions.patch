@@ -0,0 +1,136 @@
+package server
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"github.com/goccy/bigquery-emulator/internal/metadata"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+type loadSession struct {
+	job         *metadata.Job
+	data        []byte
+	updated     time.Time
+	done        bool
+	finalRange  string
+	finalDigest [32]byte
+}
+
+type uploadSessions struct {
+	mu       sync.Mutex
+	sessions map[string]*loadSession
+	bytes    int
+}
+
+func (u *uploadSessions) expire(ctx context.Context, server *Server) {
+	if u.sessions == nil {
+		u.sessions = map[string]*loadSession{}
+	}
+	for key, s := range u.sessions {
+		if time.Since(s.updated) < 10*time.Minute {
+			continue
+		}
+		if !s.done {
+			if err := failLoad(ctx, server, s.job, int64(len(s.data)), 0, errInvalid("upload session expired")); err != nil {
+				continue // unreadable/unsaved state is never silently treated as a success
+			}
+		}
+		u.bytes -= len(s.data)
+		delete(u.sessions, key)
+	}
+}
+
+func uploadKey(project, job string) string { return project + "/" + job }
+
+func (h *uploadContentHandler) serveChunks(w http.ResponseWriter, r *http.Request, server *Server, job *metadata.Job) {
+	_ = http.NewResponseController(w).SetReadDeadline(time.Now().Add(10 * time.Second))
+	raw, err := io.ReadAll(io.LimitReader(r.Body, uploadLimit+1))
+	if err != nil || len(raw) > uploadLimit {
+		errorResponse(r.Context(), w, errInvalid("upload chunk exceeds limit or read deadline"))
+		return
+	}
+	u := &server.uploads
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	key := uploadKey(job.ProjectID, job.ID)
+	s := u.sessions[key]
+	if s == nil {
+		errorResponse(r.Context(), w, errInvalid("unknown or expired upload session; inspect jobs.get"))
+		return
+	}
+	rangeHeader := r.Header.Get("Content-Range")
+	status := rangeHeader == "bytes */*" || (strings.HasPrefix(rangeHeader, "bytes */") && rangeHeader != "bytes */0")
+	if s.done {
+		if !status && (s.finalRange != rangeHeader || s.finalDigest != sha256.Sum256(raw)) {
+			errorResponse(r.Context(), w, errInvalid("finalized upload content differs from original"))
+			return
+		}
+		encodeResponse(r.Context(), w, job.Content())
+		return
+	}
+	start, total := int64(len(s.data)), int64(-1)
+	if rangeHeader != "" && !status && rangeHeader != "bytes */0" {
+		var end int64
+		var totalText string
+		if n, _ := fmt.Sscanf(rangeHeader, "bytes %d-%d/%s", &start, &end, &totalText); n != 3 || start < 0 || end-start+1 != int64(len(raw)) {
+			errorResponse(r.Context(), w, errInvalid("invalid Content-Range"))
+			return
+		}
+		if totalText != "*" {
+			total, err = strconv.ParseInt(totalText, 10, 64)
+			if err != nil || total < end+1 || total > uploadLimit {
+				errorResponse(r.Context(), w, errInvalid("invalid upload total"))
+				return
+			}
+		}
+	} else if rangeHeader == "" || rangeHeader == "bytes */0" {
+		total = start + int64(len(raw))
+	}
+	if !status {
+		if start > int64(len(s.data)) || start+int64(len(raw)) > uploadLimit {
+			errorResponse(r.Context(), w, errInvalid("out-of-order or oversized upload chunk"))
+			return
+		}
+		if start < int64(len(s.data)) {
+			if start+int64(len(raw)) > int64(len(s.data)) || !bytes.Equal(s.data[start:start+int64(len(raw))], raw) {
+				errorResponse(r.Context(), w, errInvalid("replayed chunk differs from original"))
+				return
+			}
+		} else {
+			if u.bytes+len(raw) > 32<<20 {
+				errorResponse(r.Context(), w, errInvalid("aggregate upload byte limit exceeded"))
+				return
+			}
+			s.data = append(s.data, raw...)
+			u.bytes += len(raw)
+		}
+	}
+	s.updated = time.Now()
+	if status || total < 0 || int64(len(s.data)) != total {
+		if len(s.data) > 0 {
+			w.Header().Set("Range", fmt.Sprintf("bytes=0-%d", len(s.data)-1))
+		}
+		w.WriteHeader(308)
+		return
+	}
+	contentRequest := &uploadContentRequest{server: server, project: projectFromContext(r.Context()),
+		job: job, reader: bytes.NewReader(s.data)}
+	err = h.Handle(r.Context(), contentRequest)
+	if err != nil {
+		if persistErr := failLoad(r.Context(), server, job, contentRequest.inputBytes, contentRequest.started, err); persistErr != nil {
+			errorResponse(r.Context(), w, errInternalError(persistErr.Error()))
+			return
+		}
+	}
+	s.done, s.finalRange, s.finalDigest = true, rangeHeader, sha256.Sum256(raw)
+	u.bytes -= len(s.data)
+	s.data = nil
+	encodeResponse(r.Context(), w, job.Content())
+}
