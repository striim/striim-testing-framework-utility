+package internal
+
+import (
+	"reflect"
+	"runtime"
+	"sort"
+	"testing"
+
+	googlesql "github.com/goccy/go-googlesql"
+)
+
+func TestBuiltinCatalogTypeStorageIsBounded(t *testing.T) {
+	if err := googlesql.Init(); err != nil {
+		t.Fatal(err)
+	}
+	warm := newSimpleCatalog("warm")
+	if warm == nil {
+		t.Fatal("catalog initialization failed")
+	}
+	reference := buildBuiltinCatalog("reference")
+	if reference == nil {
+		t.Fatal("reference builtin registration failed")
+	}
+	for _, names := range []func(*googlesql.SimpleCatalog) ([]string, error){
+		(*googlesql.SimpleCatalog).FunctionNames,
+		(*googlesql.SimpleCatalog).CatalogNames,
+		(*googlesql.SimpleCatalog).TableValuedFunctionNames,
+	} {
+		want, err := names(reference)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err := names(warm)
+		if err != nil {
+			t.Fatal(err)
+		}
+		sort.Strings(want)
+		sort.Strings(got)
+		if !reflect.DeepEqual(got, want) {
+			t.Fatalf("builtin names changed: got %v want %v", got, want)
+		}
+	}
+	checkSchemas := func() {
+		t.Helper()
+		for _, spec := range []struct {
+			name string
+			kind googlesql.TypeKind
+			want string
+		}{
+			{"count", googlesql.TypeKindTypeInt64, "ARRAY<STRUCT<term STRING, count INT64>>"},
+			{"score", googlesql.TypeKindTypeDouble, "ARRAY<STRUCT<term STRING, score DOUBLE>>"},
+		} {
+			text, err := tf().MakeSimpleType(googlesql.TypeKindTypeString)
+			if err != nil {
+				t.Fatal(err)
+			}
+			value, err := tf().MakeSimpleType(spec.kind)
+			if err != nil {
+				t.Fatal(err)
+			}
+			arg := newBQArgBuilders(warm, tf()).mkArrayStructArg([]*googlesql.StructField{
+				{Name: "term", Type_: text}, {Name: spec.name, Type_: value},
+			})
+			if arg == nil {
+				t.Fatal("builtin return type unavailable")
+			}
+			typ, err := arg.Type()
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, err := typ.DebugString(false)
+			if err != nil || got != spec.want {
+				t.Fatalf("builtin schema got %q, want %q: %v", got, spec.want, err)
+			}
+		}
+	}
+	checkSchemas()
+	before, err := tf().GetEstimatedOwnedMemoryBytesSize()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 30; i++ {
+		catalog := newSimpleCatalog("recreated")
+		if catalog == nil {
+			t.Fatal("catalog recreation failed")
+		}
+		runtime.KeepAlive(catalog)
+	}
+	runtime.GC()
+	runtime.GC()
+	after, err := tf().GetEstimatedOwnedMemoryBytesSize()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("owned type bytes before=%d after=%d", before, after)
+	if after > before+1024 {
+		t.Fatalf("identical builtin schemas retain type storage per catalog: %d bytes", after-before)
+	}
+	checkSchemas()
+	runtime.KeepAlive(warm)
+	runtime.KeepAlive(reference)
+}
