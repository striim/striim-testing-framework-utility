+
 func newSimpleCatalog(name string) *googlesql.SimpleCatalog {
+	builtins := sharedBuiltinCatalog()
+	if builtins == nil {
+		return nil
+	}
+	catalog, err := googlesql.NewSimpleCatalog(name, tf())
+	if err != nil || catalog == nil {
+		return nil
+	}
+	functions, err := builtins.Functions()
+	if err != nil {
+		return nil
+	}
+	seen := map[string]bool{}
+	for _, function := range functions {
+		name, err := function.Name()
+		if err != nil {
+			return nil
+		}
+		name = strings.ToLower(name)
+		if seen[name] {
+			continue // Functions includes a second entry for an alias.
+		}
+		seen[name] = true
+		if err := catalog.AddFunction(function); err != nil {
+			return nil
+		}
+	}
+	catalogs, err := builtins.Catalogs()
+	if err != nil {
+		return nil
+	}
+	for _, child := range catalogs {
+		if err := catalog.AddCatalog(child); err != nil {
+			return nil
+		}
+	}
+	tvfs, err := builtins.TableValuedFunctions()
+	if err != nil {
+		return nil
+	}
+	for _, tvf := range tvfs {
+		if err := catalog.AddTableValuedFunction(tvf); err != nil {
+			return nil
+		}
+	}
+	return catalog
+}
