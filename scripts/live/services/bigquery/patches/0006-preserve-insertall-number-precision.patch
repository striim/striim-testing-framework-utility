+package server_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+func TestInsertAllLiteralNumberPrecision(t *testing.T) {
+	s, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = s.Load(server.StructSource(types.NewProject("test", types.NewDataset("slt",
+		types.NewTable("target", []*types.Column{types.NewColumn("n", types.INT64), types.NewColumn("amount", types.NUMERIC), types.NewColumn("fraction", types.FLOAT64)}, nil),
+	)))); err != nil {
+		t.Fatal(err)
+	}
+	ts := s.TestServer()
+	defer ts.Close()
+	defer s.Stop(context.Background())
+	client := &http.Client{Timeout: 10 * time.Second}
+	root := ts.URL + "/bigquery/v2/projects/test/datasets/slt/tables/target"
+	// These literal bytes and expected strings are hand-derived. No float64
+	// conversion is permitted before the request reaches the server decoder.
+	payload := `{"rows":[{"json":{"n":9007199254740993,"amount":12.3400,"fraction":1.25}},{"json":{"n":-9007199254740993,"amount":-12.3400,"fraction":-1.25}},{"json":{"n":9223372036854775807,"amount":0.0001,"fraction":0.5}},{"json":{"n":-9223372036854775808,"amount":-0.0001,"fraction":-0.5}}]}`
+	r, err := client.Post(root+"/insertAll", "application/json", bytes.NewBufferString(payload))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var insert map[string]any
+	if err = json.NewDecoder(r.Body).Decode(&insert); err != nil {
+		t.Fatal(err)
+	}
+	r.Body.Close()
+	if r.StatusCode != 200 || insert["insertErrors"] != nil {
+		t.Fatalf("insert status=%d body=%v", r.StatusCode, insert)
+	}
+	r, err = client.Get(root + "/data")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Body.Close()
+	var doc struct {
+		Rows []struct {
+			F []struct {
+				V string `json:"v"`
+			} `json:"f"`
+		} `json:"rows"`
+	}
+	if err = json.NewDecoder(r.Body).Decode(&doc); err != nil {
+		t.Fatal(err)
+	}
+	got := make([][]string, 0, len(doc.Rows))
+	for _, row := range doc.Rows {
+		var cells []string
+		for _, cell := range row.F {
+			cells = append(cells, cell.V)
+		}
+		got = append(got, cells)
+	}
+	want := [][]string{{"9007199254740993", "12.34", "1.25"}, {"-9007199254740993", "-12.34", "-1.25"}, {"9223372036854775807", "0.0001", "0.5"}, {"-9223372036854775808", "-0.0001", "-0.5"}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("literal numeric round-trip: got %v want %v", got, want)
+	}
+}
