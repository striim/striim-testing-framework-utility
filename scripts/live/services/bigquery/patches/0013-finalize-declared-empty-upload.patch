+package server
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+)
+
+func TestUploadStandardEmptyFinal(t *testing.T) {
+	f := newUploadFixture(t)
+	location := f.begin("empty_final", "|", "WRITE_APPEND")
+	payload := []byte("1|first\n")
+	f.call("PUT", location, payload, map[string]string{"Content-Range": fmt.Sprintf("bytes 0-%d/*", len(payload)-1)}, 308)
+	f.call("PUT", location, nil, map[string]string{"Content-Range": "bytes */*"}, 308)
+	f.call("PUT", location, nil, map[string]string{"Content-Range": "bytes */0"}, 400)
+	f.call("PUT", location, nil, map[string]string{"Content-Range": "bytes */9"}, 308)
+	if len(f.rows()) != 0 {
+		t.Fatal("unknown total or incomplete declaration committed rows")
+	}
+	headers := map[string]string{"Content-Range": "bytes */8"}
+	done, _ := f.call("PUT", location, nil, headers, 200)
+	replay, _ := f.call("PUT", location, nil, headers, 200)
+	if done["status"].(map[string]interface{})["state"] != "DONE" || !reflect.DeepEqual(done, replay) || !reflect.DeepEqual(f.rows(), map[string]string{"1": "first"}) {
+		t.Fatalf("final/replay mismatch %v %v", done, replay)
+	}
+}
