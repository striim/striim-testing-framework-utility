+package server_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+func TestQueryResultLifetime(t *testing.T) {
+	for _, mode := range []string{"anonymous", "explicit", "modified", "replaced"} {
+		t.Run(mode, func(t *testing.T) {
+			s, err := server.New(server.TempStorage)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = s.Load(server.StructSource(types.NewProject("test"))); err != nil {
+				t.Fatal(err)
+			}
+			ts := s.TestServer()
+			defer ts.Close()
+			defer s.Stop(context.Background())
+			client := &http.Client{Timeout: 10 * time.Second}
+			root := ts.URL + "/bigquery/v2/projects/test"
+			call := func(method, path, body string, status int) map[string]any {
+				t.Helper()
+				req, err := http.NewRequest(method, root+path, bytes.NewBufferString(body))
+				if err != nil {
+					t.Fatal(err)
+				}
+				req.Header.Set("Content-Type", "application/json")
+				resp, err := client.Do(req)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer resp.Body.Close()
+				var doc map[string]any
+				json.NewDecoder(resp.Body).Decode(&doc)
+				if resp.StatusCode != status {
+					t.Fatalf("%s %s: want%d got%d: %v", method, path, status, resp.StatusCode, doc)
+				}
+				return doc
+			}
+			destination := ""
+			if mode == "explicit" {
+				call("POST", "/datasets", `{"datasetReference":{"projectId":"test","datasetId":"caller"}}`, 200)
+				destination = `,"destinationTable":{"projectId":"test","datasetId":"caller","tableId":"result"}`
+			}
+			for i := 0; i < 3; i++ {
+				job := fmt.Sprintf("query_%d", i)
+				doc := call("POST", "/jobs", fmt.Sprintf(`{"jobReference":{"projectId":"test","jobId":%q},"configuration":{"query":{"query":"SELECT 1 AS n","useLegacySql":false%s}}}`, job, destination), 200)
+				ref := doc["configuration"].(map[string]any)["query"].(map[string]any)["destinationTable"].(map[string]any)
+				dataset := ref["datasetId"].(string)
+				table := ref["tableId"].(string)
+				path := "/datasets/" + dataset + "/tables/" + table
+				rows := call("GET", path+"/data", "", 200)["rows"].([]any)
+				if len(rows) != 1 {
+					t.Fatal(rows)
+				}
+				if mode == "modified" {
+					call("POST", "/datasets/"+dataset+"/tables", `{"tableReference":{"projectId":"test","datasetId":"`+dataset+`","tableId":"caller_table"},"schema":{"fields":[{"name":"n","type":"INTEGER"}]}}`, 200)
+				}
+				if mode == "replaced" {
+					call("DELETE", path, "", 200)
+					call("POST", "/datasets/"+dataset+"/tables", `{"tableReference":{"projectId":"test","datasetId":"`+dataset+`","tableId":"`+table+`"},"schema":{"fields":[{"name":"n","type":"INTEGER"}]}}`, 200)
+				}
+				call("DELETE", "/jobs/"+job+"/delete", "", 200)
+				want := 200
+				if mode == "anonymous" {
+					want = 404
+				}
+				call("GET", path+"/data", "", want)
+				call("GET", "/datasets/"+dataset, "", want)
+				if mode == "modified" {
+					call("GET", "/datasets/"+dataset+"/tables/caller_table", "", 200)
+				}
+				if mode != "anonymous" {
+					break
+				}
+			}
+		})
+	}
+}
