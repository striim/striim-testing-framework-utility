+++ b/server/query_result_lifetime.go
@@ -0,0 +1,52 @@
+package server
+
+import (
+	"context"
+
+	"github.com/goccy/bigquery-emulator/internal/connection"
+	"github.com/goccy/bigquery-emulator/internal/contentdata"
+	"github.com/goccy/bigquery-emulator/internal/metadata"
+)
+
+// Anonymous SELECT destinations have the job's lifetime. Deleting just the
+// job leaves its table and dataset live, including a SQL catalog containing
+// builtin functions for every dataset. DROP TABLE releases that catalog.
+// Only results committed by this server instance are eligible. Explicit
+// destinations and anonymous namespaces subsequently changed by callers
+// are never adopted as cleanup targets.
+func (s *Server) deleteAnonymousQueryResult(ctx context.Context, tx *connection.Tx, project *metadata.Project, job *metadata.Job) error {
+	owner := s.anonymousResultOwners[anonymousQueryKey{project.ID, job.ID}]
+	if owner == "" {
+		return nil
+	}
+	cfg := job.Content().Configuration
+	if cfg == nil || cfg.Query == nil || cfg.Query.DestinationTable == nil {
+		return nil
+	}
+	ref := cfg.Query.DestinationTable
+	if ref.ProjectId != project.ID || ref.DatasetId != job.ID || ref.TableId != job.ID {
+		return nil
+	}
+	dataset := project.Dataset(ref.DatasetId)
+	if dataset == nil || len(dataset.Tables()) != 1 || len(dataset.Models()) != 0 || len(dataset.Routines()) != 0 {
+		return nil
+	}
+	table := dataset.Table(ref.TableId)
+	if table == nil {
+		return nil
+	}
+	content, err := table.Content()
+	if err != nil {
+		return err
+	}
+	if content.Labels["emulator_result_owner"] != owner {
+		return nil
+	}
+	if err := s.contentRepo.DeleteTables(ctx, tx, project.ID, dataset.ID, []contentdata.TableDeletion{{ID: table.ID}}); err != nil {
+		return err
+	}
+	if err := table.Delete(ctx, tx.Tx()); err != nil {
+		return err
+	}
+	return project.DeleteDataset(ctx, tx.Tx(), dataset.ID)
+}
