+// CSV temporal qualification is deliberately limited to these documented formats.
+func csvScalar(value, typ string) (interface{}, error) {
+	var err error
+	switch typ {
+	case "STRING", "INTEGER", "INT64", "NUMERIC":
+		return value, validateCSVNumber(value, typ)
+	case "BYTES":
+		var decoded []byte
+		decoded, err = base64.StdEncoding.Strict().DecodeString(value)
+		if err == nil {
+			return decoded, nil
+		}
+	case "BOOLEAN", "BOOL":
+		switch strings.ToLower(value) {
+		case "1", "true", "t", "yes", "y":
+			return true, nil
+		case "0", "false", "f", "no", "n":
+			return false, nil
+		default:
+			err = fmt.Errorf("invalid boolean")
+		}
+	case "FLOAT", "FLOAT64":
+		_, err = strconv.ParseFloat(value, 64)
+	case "DATE", "DATETIME", "TIME", "TIMESTAMP":
+		layout, pattern := "2006-01-02", `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`
+		if typ == "DATETIME" || typ == "TIMESTAMP" {
+			layout += " 15:04:05"
+			pattern = `^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,6})?$`
+		}
+		if typ == "TIME" {
+			layout, pattern = "15:04:05", `^[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,6})?$`
+		}
+		text := value
+		if typ == "TIMESTAMP" {
+			text = strings.TrimSuffix(strings.TrimSuffix(strings.Replace(value, "T", " ", 1), "Z"), " UTC")
+		}
+		var parsed time.Time
+		parsed, err = time.Parse(layout, text)
+		if !regexp.MustCompile(pattern).MatchString(text) || (typ != "TIME" && parsed.Year() < 1) {
+			err = fmt.Errorf("unqualified temporal CSV format")
+		}
+		if err == nil && typ == "TIMESTAMP" {
+			return parsed, nil
+		}
+	default:
+		return nil, errInvalid("unqualified CSV type: " + typ)
+	}
+	if err != nil {
+		return nil, &csvRecordError{errInvalid("invalid " + typ + " CSV value")}
+	}
+	return value, nil
 }
 
