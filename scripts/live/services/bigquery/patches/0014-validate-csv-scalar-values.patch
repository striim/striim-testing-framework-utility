+package server
+
+import (
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestCSVScalarLiteralContract(t *testing.T) {
+	// YQBi/w== decodes to literal bytes 0x61,0x00,0x62,0xff.
+	for _, tc := range []struct {
+		typ, raw string
+		want     interface{}
+	}{
+		{"BYTES", "YQBi/w==", []byte{97, 0, 98, 255}}, {"BYTES", "", []byte{}},
+		{"BOOL", "YeS", true}, {"BOOLEAN", "n", false}, {"BOOL", "1", true}, {"BOOL", "0", false},
+		{"FLOAT64", "-1.25e2", "-1.25e2"}, {"DATE", "2000-02-29", "2000-02-29"},
+		{"DATETIME", "1969-12-31 23:59:59.999999", "1969-12-31 23:59:59.999999"},
+		{"TIME", "23:59:59.123456", "23:59:59.123456"},
+		{"TIMESTAMP", "1969-12-31T23:59:59.999999Z", time.Date(1969, 12, 31, 23, 59, 59, 999999000, time.UTC)},
+	} {
+		t.Run(tc.typ+tc.raw, func(t *testing.T) {
+			fields := []*bigqueryv2.TableFieldSchema{{Name: "v", Type: tc.typ}}
+			_, rows, err := csvData([][]string{{tc.raw}}, &bigqueryv2.JobConfigurationLoad{NullMarker: "NULL"}, fields)
+			if err != nil || !reflect.DeepEqual(rows[0]["v"], tc.want) {
+				t.Fatalf("got=%v err=%v want=%#v", rows, err, tc.want)
+			}
+		})
+	}
+}
+func TestCSVScalarRejectsMalformed(t *testing.T) {
+	for _, tc := range []struct{ typ, raw string }{
+		{"BYTES", "raw!"}, {"BYTES", "Zh=="}, {"BOOL", "truthy"}, {"FLOAT64", "1.2oops"},
+		{"DATE", "2023-02-29"}, {"DATE", "0000-01-01"}, {"DATETIME", "2024-01-01 24:00:00"},
+		{"TIMESTAMP", "not-a-timestamp"}, {"TIMESTAMP", "2024-01-01 00:00:00.1234567"}, {"TIME", "12:60:00"},
+		{"JSON", "{}"},
+	} {
+		t.Run(tc.typ+tc.raw, func(t *testing.T) {
+			fields := []*bigqueryv2.TableFieldSchema{{Name: "v", Type: tc.typ}}
+			if _, _, err := csvData([][]string{{tc.raw}}, &bigqueryv2.JobConfigurationLoad{NullMarker: "NULL"}, fields); err == nil {
+				t.Fatal("malformed scalar accepted")
+			}
+		})
+	}
+}
+func TestCSVDefaultNullMarker(t *testing.T) {
+	fields := []*bigqueryv2.TableFieldSchema{{Name: "s", Type: "STRING"}, {Name: "b", Type: "BYTES"}}
+	_, rows, err := csvData([][]string{{"", ""}}, &bigqueryv2.JobConfigurationLoad{}, fields)
+	if err != nil || rows[0]["s"] != nil || rows[0]["b"] != nil {
+		t.Fatalf("default marker must be NULL: %v %v", rows, err)
+	}
+}
