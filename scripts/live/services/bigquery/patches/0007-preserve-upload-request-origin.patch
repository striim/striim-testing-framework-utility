+package server
+
+import (
+	"net/http/httptest"
+	"testing"
+)
+
+func TestUploadOriginExplicitTrust(t *testing.T) {
+	r := httptest.NewRequest("POST", "http://127.0.0.1:19050/upload", nil)
+	r.Header.Set("X-Forwarded-Proto", "https")
+	r.Header.Set("X-Forwarded-Host", "proxy.example.test:9443")
+	t.Setenv("BIGQUERY_EMULATOR_TRUST_FORWARDED_ORIGIN", "")
+	if got, err := uploadOrigin(r); err != nil || got != "http://127.0.0.1:19050" {
+		t.Fatalf("untrusted headers: %q %v", got, err)
+	}
+	t.Setenv("BIGQUERY_EMULATOR_TRUST_FORWARDED_ORIGIN", "true")
+	if got, err := uploadOrigin(r); err != nil || got != "https://proxy.example.test:9443" {
+		t.Fatalf("trusted headers: %q %v", got, err)
+	}
+	r.Header.Set("X-Forwarded-Proto", "ftp")
+	if _, err := uploadOrigin(r); err == nil {
+		t.Fatal("invalid forwarded scheme accepted")
+	}
+}
