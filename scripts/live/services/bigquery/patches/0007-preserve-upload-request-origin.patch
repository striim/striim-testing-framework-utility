+++ b/server/load_origin.go
@@ -0,0 +1,30 @@
+package server
+
+import (
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+)
+
+func uploadOrigin(r *http.Request) (string, error) {
+	scheme, host := "http", r.Host
+	if r.TLS != nil {
+		scheme = "https"
+	}
+	// Forwarded headers are ignored unless the operator explicitly trusts its proxy.
+	if os.Getenv("BIGQUERY_EMULATOR_TRUST_FORWARDED_ORIGIN") == "true" {
+		if v := r.Header.Get("X-Forwarded-Proto"); v != "" {
+			scheme = v
+		}
+		if v := r.Header.Get("X-Forwarded-Host"); v != "" {
+			host = v
+		}
+	}
+	u, err := url.Parse(scheme + "://" + host)
+	if err != nil || (scheme != "http" && scheme != "https") || host == "" || strings.Contains(host, ",") ||
+		u.User != nil || u.Path != "" || u.RawQuery != "" || u.Fragment != "" || u.Hostname() == "" {
+		return "", errInvalid("invalid upload request origin")
+	}
+	return u.String(), nil
+}
