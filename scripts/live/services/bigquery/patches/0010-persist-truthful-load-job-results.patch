+package server
+
+import (
+	"encoding/json"
+	"github.com/goccy/bigquery-emulator/internal/metadata"
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+	"testing"
+	"time"
+)
+
+func TestLoadTerminalMetadataRecordsActualStart(t *testing.T) {
+	created := time.Now().Add(-time.Second).UnixMilli()
+	started := time.Now().Add(-time.Millisecond).UnixMilli()
+	job := metadata.NewJob(nil, "test", "load", &bigqueryv2.Job{Status: &bigqueryv2.JobStatus{State: "PENDING"}, Statistics: &bigqueryv2.JobStatistics{CreationTime: created}}, nil, nil)
+	for _, failure := range []bool{false, true} {
+		var cause error
+		if failure {
+			cause = &csvRecordError{errInvalid("literal bad numeric control")}
+		}
+		content := loadContent(job, 123, 2, 17, started, cause)
+		if content.Status.State != "DONE" || content.Statistics.CreationTime != created || content.Statistics.StartTime != started || content.Statistics.EndTime < started {
+			t.Fatalf("incorrect terminal times: %+v", content)
+		}
+		stats := content.Statistics.Load
+		if stats.InputFileBytes != 123 || stats.InputFiles != 1 {
+			t.Fatalf("input accounting: %+v", stats)
+		}
+		if failure {
+			if stats.OutputRows != 0 || stats.OutputBytes != 0 || stats.BadRecords != 1 || content.Status.ErrorResult == nil {
+				t.Fatalf("failed load reported success: %+v", content)
+			}
+		} else {
+			if stats.OutputRows != 2 || stats.OutputBytes != 17 || stats.BadRecords != 0 || content.Status.ErrorResult != nil {
+				t.Fatalf("successful load metadata: %+v", content)
+			}
+		}
+		raw, err := json.Marshal(content)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var encoded map[string]interface{}
+		if err = json.Unmarshal(raw, &encoded); err != nil {
+			t.Fatal(err)
+		}
+		load := encoded["statistics"].(map[string]interface{})["load"].(map[string]interface{})
+		if _, ok := load["badRecords"]; !ok {
+			t.Fatal("zero badRecords omitted")
+		}
+	}
+	if job.Content().Status.State != "PENDING" || job.Content().Statistics.StartTime != 0 {
+		t.Fatal("terminal snapshot mutated pending job before commit")
+	}
+}
+
+func TestReloadedLoadRetainsZeroStatistics(t *testing.T) {
+	job := metadata.NewJob(nil, "test", "zero", &bigqueryv2.Job{Configuration: &bigqueryv2.JobConfiguration{Load: &bigqueryv2.JobConfigurationLoad{}}, Statistics: &bigqueryv2.JobStatistics{CreationTime: time.Now().UnixMilli()}}, nil, nil)
+	terminal := loadContent(job, 0, 0, 0, time.Now().UnixMilli(), nil)
+	raw, err := json.Marshal(terminal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded bigqueryv2.Job
+	if err = json.Unmarshal(raw, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	reloaded := metadata.NewJob(nil, "test", "zero", &decoded, nil, nil)
+	raw, err = json.Marshal(reloaded.Content())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wire map[string]interface{}
+	if err = json.Unmarshal(raw, &wire); err != nil {
+		t.Fatal(err)
+	}
+	stats := wire["statistics"].(map[string]interface{})["load"].(map[string]interface{})
+	for _, key := range []string{"inputFileBytes", "inputFiles", "outputRows", "outputBytes", "badRecords"} {
+		if _, ok := stats[key]; !ok {
+			t.Fatalf("reload omitted %s: %s", key, raw)
+		}
+	}
+}
+
+func TestLoadNonRecordErrorDoesNotInventBadRows(t *testing.T) {
+	job := metadata.NewJob(nil, "test", "missing", &bigqueryv2.Job{Configuration: &bigqueryv2.JobConfiguration{Load: &bigqueryv2.JobConfigurationLoad{}}}, nil, nil)
+	content := loadContent(job, 17, 0, 0, time.Now().UnixMilli(), errNotFound("missing dataset"))
+	if content.Status.ErrorResult.Reason != "notFound" || content.Statistics.Load.BadRecords != 0 || content.Statistics.Load.OutputRows != 0 {
+		t.Fatalf("invented load results: %+v", content)
+	}
+}
