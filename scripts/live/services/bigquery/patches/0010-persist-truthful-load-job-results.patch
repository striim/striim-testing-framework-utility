@@ -0,0 +1,62 @@
+package server
+
+import (
+	"context"
+	"errors"
+	"github.com/goccy/bigquery-emulator/internal/metadata"
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+	"time"
+)
+
+func loadContent(job *metadata.Job, size int64, rows int64, outputBytes int64, started int64, cause error) *bigqueryv2.Job {
+	content := *job.Content()
+	now := time.Now().UnixMilli()
+	created := now
+	if content.Statistics != nil && content.Statistics.CreationTime != 0 {
+		created = content.Statistics.CreationTime
+	}
+	content.Status = &bigqueryv2.JobStatus{State: "DONE"}
+	bad := int64(0)
+	if cause != nil {
+		rows, outputBytes = 0, 0
+		reason := "invalid"
+		var serverErr *ServerError
+		if errors.As(cause, &serverErr) {
+			reason = string(serverErr.Reason)
+		}
+		var recordErr *csvRecordError
+		if errors.As(cause, &recordErr) {
+			bad = 1
+		}
+		content.Status.ErrorResult = &bigqueryv2.ErrorProto{Reason: reason, Message: cause.Error()}
+		content.Status.Errors = []*bigqueryv2.ErrorProto{content.Status.ErrorResult}
+	}
+	content.Statistics = &bigqueryv2.JobStatistics{CreationTime: created, StartTime: started, EndTime: now,
+		Load: &bigqueryv2.JobStatistics3{InputFileBytes: size, InputFiles: 1, OutputRows: rows, OutputBytes: outputBytes,
+			BadRecords: bad, ForceSendFields: []string{"InputFileBytes", "InputFiles", "OutputRows", "OutputBytes", "BadRecords"}}}
+	return &content
+}
+
+func failLoad(ctx context.Context, server *Server, job *metadata.Job, size int64, started int64, cause error) error {
+	content := loadContent(job, size, 0, 0, started, cause)
+	conn, err := server.connMgr.Connection(ctx, job.ProjectID, "")
+	if err != nil {
+		return err
+	}
+	tx, err := conn.Begin(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.RollbackIfNotCommitted()
+	if err := tx.MetadataRepoMode(); err != nil {
+		return err
+	}
+	if err := job.StoreLoadContent(ctx, tx.Tx(), content); err != nil {
+		return err
+	}
+	if err := tx.Commit(); err != nil {
+		return err
+	}
+	job.PublishLoadContent(content)
+	return nil
+}
