+package server
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/hex"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestUploadGzipLiteralCSV(t *testing.T) {
+	f := newUploadFixture(t)
+	// Literal gzip bytes expand to the hand-derived single row: "1"|"first" followed by newline.
+	raw, err := hex.DecodeString("1f8b08000000000000ff533254aa514acb2c2a2e51e20200f165cda90c000000")
+	if err != nil {
+		t.Fatal(err)
+	}
+	location := f.begin("gzip_literal", "|", "WRITE_APPEND")
+	uploaded, _ := f.call("PUT", location, raw, nil, 200)
+	if got := f.rows(); !reflect.DeepEqual(got, map[string]string{"1": "first"}) {
+		t.Fatalf("got %v; want one literal first row", got)
+	}
+	stats := loadStats(t, uploaded)
+	if stats["inputFileBytes"] != "32" || stats["outputRows"] != "1" || stats["outputBytes"] != "6" {
+		t.Fatal(stats)
+	}
+	if !reflect.DeepEqual(f.job("gzip_literal")["statistics"], uploaded["statistics"]) {
+		t.Fatal("persisted gzip accounting differs")
+	}
+}
+func TestUploadGzipErrorsPreserveTarget(t *testing.T) {
+	raw, _ := hex.DecodeString("1f8b08000000000000ff533254aa514acb2c2a2e51e20200f165cda90c000000")
+	corrupt := append([]byte(nil), raw...)
+	corrupt[len(corrupt)-8] ^= 1
+	var expanded bytes.Buffer
+	writer := gzip.NewWriter(&expanded)
+	if _, err := writer.Write([]byte(strings.Repeat("x", uploadLimit+1))); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name string
+		raw  []byte
+	}{{"truncated", raw[:len(raw)-4]}, {"checksum", corrupt}, {"decoded-limit", expanded.Bytes()}} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newUploadFixture(t)
+			f.call("POST", "/bigquery/v2/projects/test/datasets/slt/tables/target/insertAll", []byte(`{"rows":[{"json":{"id":99,"msg":"keep"}}]}`), nil, 200)
+			location := f.begin("gzip_bad", "|", "WRITE_TRUNCATE")
+			uploaded, _ := f.call("PUT", location, tc.raw, nil, 200)
+			if uploaded["status"].(map[string]interface{})["errorResult"] == nil {
+				t.Fatal("gzip failure reported success")
+			}
+			stats := loadStats(t, uploaded)
+			if stats["outputRows"] != "0" || stats["outputBytes"] != "0" || stats["badRecords"] != "0" {
+				t.Fatal(stats)
+			}
+			if got := f.rows(); !reflect.DeepEqual(got, map[string]string{"99": "keep"}) {
+				t.Fatalf("gzip failure mutated target %v", got)
+			}
+		})
+	}
+}
