 func loadCSV(raw []byte, load *bigqueryv2.JobConfigurationLoad) ([][]string, error) {
+	// CSV file compression is independent of the HTTP Content-Encoding header.
+	if len(raw) >= 2 && raw[0] == 0x1f && raw[1] == 0x8b {
+		reader, err := gzip.NewReader(bytes.NewReader(raw))
+		if err != nil {
+			return nil, errInvalid("invalid gzip CSV header")
+		}
+		defer reader.Close()
+		decoded, err := io.ReadAll(io.LimitReader(reader, uploadLimit+1))
+		if err != nil || len(decoded) > uploadLimit {
+			return nil, errInvalid("invalid or oversized gzip CSV")
+		}
+		raw = decoded
+	}
+
 	if !utf8.Valid(raw) || (load.Encoding != "" && load.Encoding != "UTF-8") {
 		return nil, errInvalid("only UTF-8 CSV is qualified")
 	}
