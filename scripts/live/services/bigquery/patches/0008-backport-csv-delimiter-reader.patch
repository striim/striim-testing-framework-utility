@@ -0,0 +1,23 @@
+package server
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestLoadDelimiterReader(t *testing.T) {
+	for _, delimiter := range []string{",", "|", "\t"} {
+		r, err := newLoadCSVReader(strings.NewReader("1"+delimiter+"first\n2"+delimiter+"second\n"), delimiter)
+		if err != nil {
+			t.Fatal(err)
+		}
+		rows, err := r.ReadAll()
+		if err != nil || !reflect.DeepEqual(rows, [][]string{{"1", "first"}, {"2", "second"}}) {
+			t.Fatalf("delimiter %q rows=%v err=%v", delimiter, rows, err)
+		}
+	}
+	if _, err := newLoadCSVReader(strings.NewReader("1||first\n"), "||"); err == nil {
+		t.Fatal("invalid delimiter accepted")
+	}
+}
