@@ -0,0 +1,65 @@
+package googlesql
+
+import (
+	"runtime"
+	"testing"
+	"weak"
+)
+
+func pinParameterType(t *testing.T, opt *AnalyzerOptions, factory *TypeFactory, system bool) weak.Pointer[SimpleType] {
+	t.Helper()
+	node, err := factory.MakeSimpleType(TypeKindTypeInt64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	typ, ok := node.(*SimpleType)
+	if !ok {
+		t.Fatalf("unexpected simple type wrapper %T", node)
+	}
+	if system {
+		err = opt.AddSystemVariable([]string{"kept"}, typ)
+	} else {
+		err = opt.AddQueryParameter("p", typ)
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	return weak.Make(typ)
+}
+
+func TestClearedQueryParameterReleasesOnlyItsType(t *testing.T) {
+	ensureInit(t)
+	opt, err := NewAnalyzerOptions2()
+	if err != nil {
+		t.Fatal(err)
+	}
+	factory, err := NewTypeFactory()
+	if err != nil {
+		t.Fatal(err)
+	}
+	query := pinParameterType(t, opt, factory, false)
+	system := pinParameterType(t, opt, factory, true)
+	runtime.GC()
+	if query.Value() == nil || system.Value() == nil {
+		t.Fatal("registered parameter types must remain pinned")
+	}
+	if err := opt.ClearQueryParameters(); err != nil {
+		t.Fatal(err)
+	}
+	runtime.GC()
+	runtime.GC()
+	if query.Value() != nil {
+		t.Fatal("cleared query parameter type remains pinned")
+	}
+	if system.Value() == nil {
+		t.Fatal("clearing query parameters released a system variable type")
+	}
+	// A new query must be able to bind the same name after clearing.
+	again := pinParameterType(t, opt, factory, false)
+	runtime.GC()
+	if again.Value() == nil {
+		t.Fatal("replacement query parameter was not pinned")
+	}
+	runtime.KeepAlive(opt)
+	runtime.KeepAlive(factory)
+}
