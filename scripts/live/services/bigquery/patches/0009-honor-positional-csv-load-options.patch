 package server
 
 import (
+	"bytes"
 	"encoding/csv"
 	"fmt"
+	"github.com/goccy/bigquery-emulator/types"
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
 	"io"
+	"regexp"
+	"strconv"
+	"strings"
+	"unicode/utf8"
 )
 
+const uploadLimit = 16 << 20
+
 // Delimiter helper backport from upstream PR #491.
+type csvRecordError struct{ cause error }
+
+func (e *csvRecordError) Error() string { return e.cause.Error() }
+func (e *csvRecordError) Unwrap() error { return e.cause }
+
+var csvNumericLiteral = regexp.MustCompile(`^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$`)
+
+func validateCSVNumber(value, typ string) error {
+	switch typ {
+	case "INTEGER", "INT64":
+		if _, err := strconv.ParseInt(strings.TrimSpace(value), 10, 64); err != nil {
+			return &csvRecordError{errInvalid("invalid INT64 CSV value")}
+		}
+	case "NUMERIC":
+		if !csvNumericLiteral.MatchString(strings.TrimSpace(value)) {
+			return &csvRecordError{errInvalid("invalid NUMERIC CSV value")}
+		}
+	}
+	return nil
+}
+
 func newLoadCSVReader(reader io.Reader, fieldDelimiter string) (*csv.Reader, error) {
 	csvReader := csv.NewReader(reader)
 	csvReader.FieldsPerRecord = -1
@@ -20,3 +50,80 @@
 	csvReader.Comma = delimiters[0]
 	return csvReader, nil
 }
+
+func loadCSV(raw []byte, load *bigqueryv2.JobConfigurationLoad) ([][]string, error) {
+	if !utf8.Valid(raw) || (load.Encoding != "" && load.Encoding != "UTF-8") {
+		return nil, errInvalid("only UTF-8 CSV is qualified")
+	}
+	if load.Quote != nil && *load.Quote != "\"" {
+		return nil, errInvalid("only double-quoted CSV is qualified")
+	}
+	if load.AllowJaggedRows || load.IgnoreUnknownValues || load.MaxBadRecords != 0 || load.SkipLeadingRows < 0 {
+		return nil, errInvalid("CSV requires exact row widths, zero bad rows and non-negative skipLeadingRows")
+	}
+	if !load.PreserveAsciiControlCharacters {
+		for _, b := range raw {
+			if b < 32 && b != '\n' && b != '\r' && b != '\t' {
+				return nil, errInvalid("ASCII controls require preserveAsciiControlCharacters")
+			}
+		}
+	}
+	reader, err := newLoadCSVReader(bytes.NewReader(raw), load.FieldDelimiter)
+	if err != nil {
+		return nil, err
+	}
+	records, err := reader.ReadAll()
+	if err != nil {
+		return nil, &csvRecordError{errInvalid(fmt.Sprintf("malformed CSV: %s", err))}
+	}
+	if !load.AllowQuotedNewlines {
+		for _, record := range records {
+			for _, value := range record {
+				if strings.ContainsAny(value, "\r\n") {
+					return nil, errInvalid("quoted newline requires allowQuotedNewlines")
+				}
+			}
+		}
+	}
+	return records, nil
+}
+
+func csvData(records [][]string, load *bigqueryv2.JobConfigurationLoad, fields []*bigqueryv2.TableFieldSchema) ([]*types.Column, types.Data, error) {
+	if load.Schema != nil {
+		fields = load.Schema.Fields // explicit positional schema, never inferred from data values
+	}
+	columns := make([]*types.Column, 0, len(fields))
+	for _, f := range fields {
+		if f.Mode == "REPEATED" || len(f.Fields) != 0 {
+			return nil, nil, errInvalid("CSV nested/repeated fields are unqualified")
+		}
+		columns = append(columns, &types.Column{Name: f.Name, Type: types.Type(f.Type)})
+	}
+	start := load.SkipLeadingRows
+	if load.Autodetect && start == 0 {
+		start = 1 // retain upstream's header-based autodetect; explicit schemas are positional
+	}
+	if start > int64(len(records)) {
+		start = int64(len(records))
+	}
+	data := types.Data{}
+	for _, record := range records[start:] {
+		if len(record) != len(columns) {
+			return nil, nil, &csvRecordError{errInvalid("CSV row width differs from positional schema")}
+		}
+		row := map[string]interface{}{}
+		for i, value := range record {
+			typ := strings.ToUpper(fields[i].Type)
+			if value == load.NullMarker && (value != "" || (typ != "STRING" && typ != "BYTES")) {
+				row[columns[i].Name] = nil
+			} else {
+				if err := validateCSVNumber(value, typ); err != nil {
+					return nil, nil, err
+				}
+				row[columns[i].Name] = value
+			}
+		}
+		data = append(data, row)
+	}
+	return columns, data, nil
+}
