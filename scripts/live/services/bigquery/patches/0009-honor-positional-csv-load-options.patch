+package server
+
+import (
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+	"reflect"
+	"testing"
+)
+
+func TestLoadCSVLiteralContract(t *testing.T) {
+	fields := []*bigqueryv2.TableFieldSchema{{Name: "id", Type: "INTEGER"}, {Name: "msg", Type: "STRING"}}
+	cases := []struct {
+		name, raw string
+		skip      int64
+		want      []map[string]interface{}
+	}{
+		{"zero", "", 0, []map[string]interface{}{}},
+		{"one", "1|first\n", 0, []map[string]interface{}{{"id": "1", "msg": "first"}}},
+		{"two", "1|first\n2|second\n", 0, []map[string]interface{}{{"id": "1", "msg": "first"}, {"id": "2", "msg": "second"}}},
+		{"explicit-skip", "id|msg\n1|first\n", 1, []map[string]interface{}{{"id": "1", "msg": "first"}}},
+		{"null-empty", "1|NULL\n2|\n", 0, []map[string]interface{}{{"id": "1", "msg": nil}, {"id": "2", "msg": ""}}},
+		{"quoted-pipe-unicode", "1|\"a|β\"\n", 0, []map[string]interface{}{{"id": "1", "msg": "a|β"}}},
+		{"quoted-newline", "1|\"line1\nline2\"\n", 0, []map[string]interface{}{{"id": "1", "msg": "line1\nline2"}}},
+		{"quoted-quote", "1|\"He said \"\"hi\"\"\"\n", 0, []map[string]interface{}{{"id": "1", "msg": "He said \"hi\""}}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			load := &bigqueryv2.JobConfigurationLoad{Schema: &bigqueryv2.TableSchema{Fields: fields}, FieldDelimiter: "|", NullMarker: "NULL", AllowQuotedNewlines: true, SkipLeadingRows: tc.skip}
+			records, err := loadCSV([]byte(tc.raw), load)
+			if err != nil {
+				t.Fatal(err)
+			}
+			columns, rows, err := csvData(records, load, fields)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got := []map[string]interface{}{}
+			for _, row := range rows {
+				got = append(got, row)
+			}
+			if len(columns) != 2 || !reflect.DeepEqual(got, tc.want) {
+				t.Fatalf("columns=%v rows=%v want=%v", columns, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestLoadCSVRejectsUnqualifiedInput(t *testing.T) {
+	cases := []struct {
+		name, raw string
+		modify    func(*bigqueryv2.JobConfigurationLoad)
+	}{
+		{"invalid-utf8", string([]byte{255}), func(*bigqueryv2.JobConfigurationLoad) {}},
+		{"encoding", "1|x\n", func(l *bigqueryv2.JobConfigurationLoad) { l.Encoding = "UTF-16LE" }},
+		{"quote", "1|x\n", func(l *bigqueryv2.JobConfigurationLoad) { s := "'"; l.Quote = &s }},
+		{"delimiter", "1|x\n", func(l *bigqueryv2.JobConfigurationLoad) { l.FieldDelimiter = "||" }},
+		{"quoted-newline", "1|\"x\ny\"\n", func(l *bigqueryv2.JobConfigurationLoad) { l.AllowQuotedNewlines = false }},
+		{"malformed-quote", "1|\"unfinished\n", func(*bigqueryv2.JobConfigurationLoad) {}},
+		{"jagged-option", "1|x\n", func(l *bigqueryv2.JobConfigurationLoad) { l.AllowJaggedRows = true }},
+		{"bad-record-option", "1|x\n", func(l *bigqueryv2.JobConfigurationLoad) { l.MaxBadRecords = 1 }},
+		{"negative-skip", "1|x\n", func(l *bigqueryv2.JobConfigurationLoad) { l.SkipLeadingRows = -1 }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			l := &bigqueryv2.JobConfigurationLoad{FieldDelimiter: "|", AllowQuotedNewlines: true}
+			tc.modify(l)
+			if _, err := loadCSV([]byte(tc.raw), l); err == nil {
+				t.Fatal("unsupported CSV accepted")
+			}
+		})
+	}
+	fields := []*bigqueryv2.TableFieldSchema{{Name: "id", Type: "INTEGER"}, {Name: "msg", Type: "STRING"}}
+	if _, _, err := csvData([][]string{{"1"}}, &bigqueryv2.JobConfigurationLoad{}, fields); err == nil {
+		t.Fatal("jagged row accepted")
+	}
+}
+
+func TestLoadCSVDelimiters(t *testing.T) {
+	for _, delimiter := range []string{",", "|", "\t"} {
+		t.Run(delimiter, func(t *testing.T) {
+			load := &bigqueryv2.JobConfigurationLoad{FieldDelimiter: delimiter}
+			got, err := loadCSV([]byte("1"+delimiter+"first\n2"+delimiter+"second\n"), load)
+			want := [][]string{{"1", "first"}, {"2", "second"}}
+			if err != nil || !reflect.DeepEqual(got, want) {
+				t.Fatalf("delimiter %q got=%v err=%v", delimiter, got, err)
+			}
+		})
+	}
+}
