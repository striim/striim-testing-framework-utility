# Striim Docker BUILD config — instantclient build args only.
#
# STRIIM_VERSION and JDK_VERSION are NO LONGER set here. They are derived from your
# STRIIM_HOME install: the live harness resolves them (livetest.releases) and exports the vars
# (compose interpolation + download-dependencies.sh then honor them); for a hand build,
# export them yourself first. compose.yaml and download-dependencies.sh
# default to 5.4.2 / JDK 17 when unset. NO SECRETS here — the license/product keys
# (COMPANY_NAME / PRODUCT_KEY / LICENCE_KEY / CLUSTER_NAME) come from your shell env.
INSTANTCLIENT_VERSION=216000
INSTANTCLIENT_ZIPFILE=instantclient-basic-linux.x64-21.6.0.0.0dbru.zip
INSTANTCLIENT_FOLDER=instantclient_21_6
