-- Minimal Postgres CDC pipeline, used only to demonstrate the `recover:` phase.
--
-- RECOVERY is mandatory for a recovery test: it is what makes the app checkpoint exist, so a
-- restarted app resumes from a position instead of re-reading from wherever it happens to be.
-- 10 SECOND is short enough that a checkpoint is taken during the `recover.after` window.
CREATE NAMESPACE ${NS};
USE ${NS};

CREATE OR REPLACE APPLICATION ${APP} RECOVERY 10 SECOND INTERVAL;

CREATE OR REPLACE SOURCE PgCdcSource USING Global.PostgreSQLReader (
  ConnectionURL: '${PG_URL}',
  Username: '${PG_SOURCE_USER}',
  Password: '${PG_SOURCE_PASSWORD}',
  Tables: '${PG_SOURCE_SCHEMA}.${TID}src',
  ReplicationSlotName: '${PG_SLOT}'
) OUTPUT TO SrcStream;

-- Interval:1 is what makes this the POSITIVE case. The writer commits every second, so by the
-- time `recover.after: 10` fires there is nothing uncommitted for endProcessing()'s rollback
-- to throw away. Widen either policy and this test starts losing rows -- which is the point of
-- the fan-out recovery test, not of this one.
CREATE OR REPLACE TARGET PgTarget USING Global.DatabaseWriter (
  ConnectionURL: '${PG_URL}',
  Username: '${PG_TARGET_USER}',
  Password: '${PG_TARGET_PASSWORD}',
  Tables: '${PG_SOURCE_SCHEMA}.${TID}src,${PG_TARGET_SCHEMA}.${TID}tgt',
  BatchPolicy: 'EventCount:100,Interval:1',
  CommitPolicy: 'EventCount:100,Interval:1'
) INPUT FROM SrcStream;

END APPLICATION ${APP};

DEPLOY APPLICATION ${APP};
START APPLICATION ${APP};
