CREATE NAMESPACE ${NS};
USE ${NS};

CREATE OR REPLACE APPLICATION ${APP};

CREATE OR REPLACE SOURCE ${TID}source USING Global.PostgreSQLReader (
  ConnectionURL: '${PG_URL}',
  Username: '${PG_SOURCE_USER}',
  Password: '${PG_SOURCE_PASSWORD}',
  Tables: '${PG_SOURCE_SCHEMA}.${TID}src',
  ReplicationSlotName: '${PG_SLOT}'
) OUTPUT TO ${TID}stream;

CREATE OR REPLACE TARGET ${TID}writer USING Global.KafkaWriter VERSION '2.1.0' (
  BrokerAddress: '${KAFKA_BROKER}',
  Topic: '${KAFKA_TGT_TOPIC}',
  Mode: 'Sync',
  CommitPolicy: 'EventCount:1,Interval:1'
) FORMAT USING Global.JSONFormatter (
  EventsAsArrayOfJsonObjects: 'false'
) INPUT FROM ${TID}stream;

END APPLICATION ${APP};

DEPLOY APPLICATION ${APP};
START APPLICATION ${APP};
