-- FRAMEWORK EXAMPLE: server_files. FileReader tails a server directory the framework created
-- and populated -- one file placed before DEPLOY, one after RUNNING -- and FileWriter writes
-- every parsed row back out as JSON for the `file` assert tier to read.
--
-- positionbyeof: false is what makes the post_start half work: the reader starts at the
-- beginning of each file it finds rather than at EOF, so a file that appears while the app is
-- already running is read whole.
CREATE NAMESPACE ${NS};
USE ${NS};

CREATE OR REPLACE APPLICATION ${APP};

CREATE OR REPLACE SOURCE FileSrc USING Global.FileReader (
  directory:     '/tmp/${NS}-in',
  wildcard:      '*.csv',
  positionbyeof: false
) PARSE USING Global.DSVParser (
  header:          true,
  columndelimiter: ',',
  charset:         'UTF-8'
) OUTPUT TO SrcStream;

CREATE OR REPLACE TARGET FileOut USING Global.FileWriter (
  FileName:    '/tmp/${NS}-out',
  FlushPolicy: 'EventCount:100,Interval:1s'
) FORMAT USING Global.JSONFormatter () INPUT FROM SrcStream;

END APPLICATION ${APP};

DEPLOY APPLICATION ${APP};
START APPLICATION ${APP};
