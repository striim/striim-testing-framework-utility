-- FRAMEWORK EXAMPLE: the raise path. Identical to hello-single except the writer targets a
-- table that no ddl file creates, so the app fails once data reaches the target and the
-- harness's expect_halt tier catches the terminal status instead of failing the run.
-- The single-topology twin of hello-cluster: a Postgres DatabaseReader (SourceFlow)
-- feeds a DatabaseWriter (AppFlow), all on one node. Same FLOW structure as
-- hello-cluster but deployed without placement, so it runs on any Striim. The diff
-- tier asserts tgt catches up to src.
CREATE NAMESPACE ${NS};
USE ${NS};

CREATE OR REPLACE APPLICATION ${APP};

CREATE OR REPLACE FLOW SourceFlow;
  CREATE OR REPLACE SOURCE PgSource USING Global.DatabaseReader (
    ConnectionURL: '${PG_URL}',
    Username: '${PG_SOURCE_USER}',
    Password: '${PG_SOURCE_PASSWORD}',
    Tables: '${PG_SOURCE_SCHEMA}.${TID}src'
  ) OUTPUT TO SrcStream;
END FLOW SourceFlow;

CREATE OR REPLACE FLOW AppFlow;
  CREATE OR REPLACE TARGET PgTarget USING Global.DatabaseWriter (
    ConnectionURL: '${PG_URL}',
    Username: '${PG_TARGET_USER}',
    Password: '${PG_TARGET_PASSWORD}',
    Tables: '${PG_SOURCE_SCHEMA}.${TID}src,${PG_TARGET_SCHEMA}.${TID}no_such_target',
    BatchPolicy: 'EventCount:100,Interval:1',
    CommitPolicy: 'EventCount:100,Interval:1'
  ) INPUT FROM SrcStream;
END FLOW AppFlow;

END APPLICATION ${APP};

DEPLOY APPLICATION ${APP};
START APPLICATION ${APP};
