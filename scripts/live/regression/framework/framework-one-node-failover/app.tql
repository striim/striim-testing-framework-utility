CREATE NAMESPACE ${NS};
USE ${NS};

CREATE OR REPLACE APPLICATION ${APP} RECOVERY 1 SECOND INTERVAL;

CREATE FLOW ${TID}flow;

CREATE OR REPLACE SOURCE ${TID}reader USING Global.PostgreSQLReader (
  ConnectionURL: '${PG_URL}',
  Username: '${PG_SOURCE_USER}',
  Password: '${PG_SOURCE_PASSWORD}',
  Tables: '${PG_SOURCE_SCHEMA}.${TID}src',
  ReplicationSlotName: '${PG_SLOT}'
) OUTPUT TO ${TID}events;

CREATE OR REPLACE TARGET ${TID}writer USING Global.DatabaseWriter (
  ConnectionURL: '${PG_URL}',
  Username: '${PG_TARGET_USER}',
  Password: '${PG_TARGET_PASSWORD}',
  Tables: '${PG_SOURCE_SCHEMA}.${TID}src,${PG_TARGET_SCHEMA}.${TID}tgt',
  BatchPolicy: 'EventCount:100,Interval:1',
  CommitPolicy: 'EventCount:100,Interval:1'
) INPUT FROM ${TID}events;

END FLOW ${TID}flow;
END APPLICATION ${APP};

DEPLOY APPLICATION ${APP} ON ALL IN ${APP_GROUP} WITH ${TID}flow ON ONE IN ${APP_GROUP};
START APPLICATION ${APP};
