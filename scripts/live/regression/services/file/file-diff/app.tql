-- scripts/live/regression/services/file/file-diff/app.tql
-- File in -> file out: FileReader reads input.csv (placed on the server before deploy)
-- via DSVParser, FileWriter + JSONFormatter writes each row as a JSON event to
-- /tmp/${NS}-out. The file: assertion reads the output back and matches each event's data
-- against the golden. Self-contained -- no external service; both files live on the
-- Striim server (the framework places the input + reads the output mode-aware).
CREATE NAMESPACE ${NS};
USE ${NS};

CREATE OR REPLACE APPLICATION ${APP};

CREATE OR REPLACE SOURCE FileSrc USING Global.FileReader (
  directory:     '/tmp/${NS}-in',
  wildcard:      'input.csv',
  positionbyeof: false
) PARSE USING Global.DSVParser (
  header:          true,
  columndelimiter: ',',
  charset:         'UTF-8'
) OUTPUT TO SrcStream;

CREATE OR REPLACE TARGET FileOut USING Global.FileWriter (
  FileName:    '/tmp/${NS}-out',
  FlushPolicy: 'EventCount:100,Interval:1s'
) FORMAT USING Global.JSONFormatter () INPUT FROM SrcStream;

END APPLICATION ${APP};

DEPLOY APPLICATION ${APP};
START APPLICATION ${APP};
