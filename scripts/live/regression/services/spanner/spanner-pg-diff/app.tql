-- scripts/live/regression/spanner-pg-diff/app.tql
-- Cloud Spanner (PostgreSQL dialect) SpannerBatchReader -> SpannerPGDialectWriter,
-- both targeting the emulator via the cloudspanner JDBC URL (autoConfigEmulator).
-- Incremental read of src (CheckColumn=id) is written to tgt in the same PG-dialect db.
CREATE NAMESPACE ${NS};
USE ${NS};

CREATE OR REPLACE APPLICATION ${APP};

CREATE OR REPLACE SOURCE SpannerSource USING Global.SpannerBatchReader (
  ConnectionURL: '${SPANNER_PG_URL}',
  ServiceAccountKey: 'UploadedFiles/fake-gcp-key.json',
  ProjectId: '${SPANNER_PROJECT}',
  InstanceID: '${SPANNER_INSTANCE}',
  DatabaseName: '${SPANNER_PG_DB}',
  Tables: 'public.${TID}src',
  CheckColumn: 'public.%=id',
  StartPosition: '%=0',
  FetchSize: 100,
  pollingInterval: '5sec',
  ReturnDateTimeAs: 'JODA',
  ConnectionPoolSize: 5,
  ThreadPoolSize: 5
) OUTPUT TO SrcStream;

CREATE OR REPLACE TARGET SpannerTarget USING Global.SpannerPGDialectWriter (
  ConnectionURL: '${SPANNER_PG_URL}',
  ServiceAccountKey: 'UploadedFiles/fake-gcp-key.json',
  ProjectId: '${SPANNER_PROJECT}',
  InstanceID: '${SPANNER_INSTANCE}',
  DatabaseName: '${SPANNER_PG_DB}',
  Tables: 'public.${TID}src,public.${TID}tgt',
  BatchPolicy: 'EventCount:100,Interval:1'
) INPUT FROM SrcStream;

END APPLICATION ${APP};

DEPLOY APPLICATION ${APP};
START APPLICATION ${APP};
