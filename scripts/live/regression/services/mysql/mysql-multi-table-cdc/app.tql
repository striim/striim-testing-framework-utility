CREATE NAMESPACE ${NS};
USE ${NS};

CREATE OR REPLACE APPLICATION ${APP};

CREATE OR REPLACE SOURCE SourceReader USING Global.DatabaseReader (
  ConnectionURL: '${MYSQL_URL}',
  Username: '${MYSQL_SOURCE_USER}',
  Password: '${MYSQL_SOURCE_PASSWORD}',
  Tables: '${MYSQL_SOURCE_SCHEMA}.${TID}mt_customers;${MYSQL_SOURCE_SCHEMA}.${TID}mt_orders;${MYSQL_SOURCE_SCHEMA}.${TID}mt_items'
) OUTPUT TO SourceStream;

CREATE OR REPLACE TARGET TargetWriter USING Global.DatabaseWriter (
  ConnectionURL: '${MYSQL_URL}',
  Username: '${MYSQL_TARGET_USER}',
  Password: '${MYSQL_TARGET_PASSWORD}',
  Tables: '${MYSQL_SOURCE_SCHEMA}.${TID}mt_customers,${MYSQL_TARGET_SCHEMA}.${TID}mt_customers;${MYSQL_SOURCE_SCHEMA}.${TID}mt_orders,${MYSQL_TARGET_SCHEMA}.${TID}mt_orders;${MYSQL_SOURCE_SCHEMA}.${TID}mt_items,${MYSQL_TARGET_SCHEMA}.${TID}mt_items',
  BatchPolicy: 'EventCount:100,Interval:1',
  CommitPolicy: 'EventCount:100,Interval:1'
) INPUT FROM SourceStream;

END APPLICATION ${APP};

DEPLOY APPLICATION ${APP};
START APPLICATION ${APP};
