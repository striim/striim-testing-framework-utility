# --- Shell only -----------------------------------------------------------------------------------
# These are read from your shell's environment only; this file does not set them. Export them when
# you need them (docs/SETTINGS.md describes each):
# STRIIM_HOME, SLT_SERVICES_HOST, SLT_STRIIM_NATIVE_ONLY, SLT_STRIIM_BOOT_WAIT, SLT_CLUSTER_SETTLE,
# SLT_KEEP_RESOURCES, SLT_KEEP_RESOURCES_ON_ERROR, SLT_ALLOW_NO_CLUSTER, GOLD_TARGETS,
# SLT_MACHINE_ENV, SLT_FRAMEWORK_DOTENV, SLT_LOCK_DIR, SLT_PARALLEL, SLT_RUN_DISABLED,
# SLT_SKIP_VERIFY, SLT_EMULATORS, SLT_OP_RETRY_FAILED, SLT_RECOVER_RESTORE_TIMEOUT,
# SLT_JDK<release>_HOME, SLT_PREBUILT_JAR_<MODULE>, SLT_PREBUILT_JAR, SLT_PREBUILT_DIR,
# SLT_STRIIM_DEPS_MANIFEST, SLT_STRIIM_MIN_FREE_GB, SLT_MSSQL_BOOTSTRAP_PASSWORD,
# INT_KEEP_SERVICES, INT_KEEP_RESOURCES, INT_EMULATORS, INT_VARIANT, INT_EXTRA_CLASSPATH,
# INT_PG_ALLOW_DESTRUCTIVE_RESET, INT_ALLOW_CONCURRENT_SESSIONS, INT_SHARED_SERVICES
